# Explicit allowlist: no private notes, backups, editor state or generated artifacts.
**
!Dockerfile
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.dockerignore
!.luarc.json
!.editorconfig
!stylua.toml
!tasks.py
!package.py
!deploy.py
!sync_types.py
!tools/
!tools/type_exporter.lua
!types/
!types/**
!README.md
!LICENSE
!Mods/
!Mods/BestiaryLens/
!Mods/BestiaryLens/enabled.txt
!Mods/BestiaryLens/Scripts/
!Mods/BestiaryLens/Scripts/*.lua
!tests/
!tests/**
tests/**/__pycache__/
tests/**/*.py[cod]
tests/**/*.log
